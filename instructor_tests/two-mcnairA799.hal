# ----------------------------------------------------------
# File name:    two-mcnairA799.hal
# Assign ID:    TWO
# Purpose:      Implement two if statements with a, b, d
# Author:       mcnairA799 Adrian McNair
# ----------------------------------------------------------

# ==========================================================
# PSEUDO-CODE:
#   int a, b=4,c=8, d;
#
#   cin >> a;
#
#   b = a * b;
#   cout << b;
#
#   if (b > 12) {
#       d = b - 12;
#       cout << d;
#   }
#
#   if (b < 12) {
#       a = b + 12;
#       cout << a;
#   }
# ==========================================================

        .ALLOC  5
a       .DATA
b       .DATA =4
c       .DATA =8
d       .DATA
c12     .DATA =12

        .BEGIN

        READ a
        LOAD a
        MULT b
        STORE b
        WRITE b

IF:     LOAD b
        CGT c12
        BRF ENDIF

        LOAD b
        SUB c12
        STORE d
        WRITE d

ENDIF:  CLEAR
  
IF2:     LOAD b
        CLT c12
        BRF ENDIF2

        LOAD b
        ADD c12
        STORE a
        WRITE a

ENDIF2: HALT

        .END
