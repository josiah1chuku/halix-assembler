# Assignment ID: DIGITS2
# Program Name: digits2.hal
# Purpose: Read a 2-digit number, output its digits and their sum
# Author: jamesK198.hal Kaylani James

.ALLOC 5

c10      .DATA =10    
num      .DATA        
ones     .DATA        
tens     .DATA        
digitSum .DATA        

.BEGIN
    READ num          
    WRITE num         

    LOAD num          
    MOD c10           
    STORE ones       
    WRITE ones        

    LOAD num          
    DIV c10           
    STORE tens        
    WRITE tens        

    LOAD ones         
    ADD tens          
    STORE digitSum    
    WRITE digitSum    

    HALT
.END
